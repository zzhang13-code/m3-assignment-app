extends layout

block content
  if errors
    div.alert.alert-danger
      ul.mb-0
        for error in errors
          li= error.msg
  - data = data || {}
  form(action="." method="POST")
    div.form-group
      label(for="name") Name:
      input.form-control(type="text" id="name" name="name" value=data.name)
    div.form-group
      label(for="email") Email:
      input.form-control(type="email" id="email" name="email" value=data.email)
    input.btn.btn-primary(type="submit" value="Submit")
